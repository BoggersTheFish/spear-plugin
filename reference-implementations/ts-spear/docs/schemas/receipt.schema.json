{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badgersmc.dev/ts-spear/schemas/receipt/v1",
  "title": "TS-Spear Confidence Receipt",
  "description": "Immutable audit record for every confidence mutation",
  "type": "object",
  "required": [
    "schemaVersion",
    "receiptId",
    "playerId",
    "time",
    "event",
    "dimension",
    "confidenceDelta",
    "previousValue",
    "newValue",
    "reason",
    "linkedEvidenceIds",
    "stateVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "format": "uuid"
    },
    "playerId": {
      "type": "string",
      "format": "uuid"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "world": {
      "type": ["string", "null"]
    },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "event": {
      "type": "string",
      "description": "Triggering event name, e.g. GRAPH_PROPAGATION, DECAY_APPLIED, STAFF_OVERRIDE"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "MOVEMENT",
        "COMBAT",
        "INVENTORY",
        "AUTOMATION",
        "NETWORKING",
        "INTERACTION",
        "AGGREGATE"
      ]
    },
    "confidenceDelta": {
      "type": "number",
      "description": "newValue - previousValue"
    },
    "previousValue": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "newValue": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "linkedEvidenceIds": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 0,
      "description": "PlayerState version at mutation time"
    },
    "tensionBefore": {
      "type": "number"
    },
    "tensionAfter": {
      "type": "number"
    },
    "supportingCount": {
      "type": "integer",
      "minimum": 0
    },
    "conflictingCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}