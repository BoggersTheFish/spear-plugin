{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badgersmc.dev/ts-spear/schemas/replay/v1",
  "title": "TS-Spear Replay Format",
  "description": "JSON representation of replay sequences. Binary format uses same field semantics with packed encoding.",
  "type": "object",
  "required": ["schemaVersion", "sequenceId", "playerId", "playerName", "startTick", "endTick", "startTime", "triggerReason", "frames"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "sequenceId": { "type": "string", "format": "uuid" },
    "playerId": { "type": "string", "format": "uuid" },
    "playerName": { "type": "string" },
    "startTick": { "type": "integer" },
    "endTick": { "type": "integer" },
    "startTime": { "type": "string", "format": "date-time" },
    "triggerReason": {
      "type": "string",
      "enum": ["ALERT", "STAFF_REQUEST", "FREEZE", "CONTINUOUS", "MANUAL"]
    },
    "linkedAlertId": { "type": ["string", "null"], "format": "uuid" },
    "frames": {
      "type": "array",
      "items": { "$ref": "#/$defs/ReplayFrame" }
    }
  },
  "$defs": {
    "ReplayFrame": {
      "type": "object",
      "required": ["tick", "timestamp", "type"],
      "properties": {
        "tick": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": {
          "type": "string",
          "enum": [
            "MOVEMENT",
            "HEAD_ROTATION",
            "INVENTORY",
            "DAMAGE",
            "HIT",
            "PROJECTILE",
            "BLOCK_INTERACT",
            "CHAT",
            "COMMAND",
            "TELEPORT"
          ]
        },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" },
            "yaw": { "type": "number" },
            "pitch": { "type": "number" }
          }
        },
        "velocity": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "onGround": { "type": "boolean" },
        "health": { "type": "number" },
        "ping": { "type": "integer" },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "additionalProperties": false
}