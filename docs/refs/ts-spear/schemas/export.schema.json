{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badgersmc.dev/ts-spear/schemas/export/v1",
  "title": "TS-Spear ML Export Batch",
  "description": "Batch export for InferenceProvider, FeatureExtractor, and external ML pipelines",
  "type": "object",
  "required": [
    "schemaVersion",
    "exportId",
    "exportedAt",
    "playerId",
    "timeWindow",
    "confidenceVector",
    "evidenceGraph"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "exportId": { "type": "string", "format": "uuid" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "playerId": { "type": "string", "format": "uuid" },
    "timeWindow": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "tickStart": { "type": "integer" },
        "tickEnd": { "type": "integer" }
      }
    },
    "confidenceVector": {
      "type": "object",
      "properties": {
        "movement": { "type": "number" },
        "combat": { "type": "number" },
        "inventory": { "type": "number" },
        "automation": { "type": "number" },
        "networking": { "type": "number" },
        "interaction": { "type": "number" },
        "aggregate": { "type": "number" }
      }
    },
    "evidenceGraph": {
      "type": "object",
      "properties": {
        "nodes": { "type": "array" },
        "edges": { "type": "array" }
      }
    },
    "movementSequence": {
      "type": "array",
      "description": "float[N][F] flattened or nested feature vectors per tick",
      "items": { "type": "array", "items": { "type": "number" } }
    },
    "combatSequence": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "number" } }
    },
    "packetSequence": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "number" } }
    },
    "features": {
      "type": "array",
      "items": { "type": "number" }
    },
    "featureNames": {
      "type": "array",
      "items": { "type": "string" }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "receipt.schema.json" }
    },
    "label": {
      "type": ["object", "null"],
      "description": "Optional staff annotation for supervised learning",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["LEGIT", "SUSPICIOUS", "CHEATING", "INCONCLUSIVE"]
        },
        "annotatedBy": { "type": "string" },
        "annotatedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}